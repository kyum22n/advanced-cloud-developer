{
  "environment": "prd",
  "description": "Azure AKS + PaaS 운영 환경 — 가용성·보안·관측·복구가 기본값이며 데이터는 관리형 서비스가 책임진다",
  "azure": {
    "resourceGroup": "rg-myapp-prd",
    "location": "koreacentral",
    "acrName": "acrmyappprd",
    "network": {
      "vnetName": "vnet-myapp-prd",
      "vnetCidr": "10.20.0.0/16",
      "aksSubnetName": "snet-aks",
      "aksSubnetCidr": "10.20.0.0/22",
      "dataSubnetName": "snet-data",
      "dataSubnetCidr": "10.20.4.0/24"
    },
    "aks": {
      "name": "aks-myapp-prd",
      "tier": "standard",
      "systemNodeCount": 3,
      "systemNodeSize": "Standard_D2s_v5",
      "userNodeCount": 1,
      "userNodeSize": "Standard_D2s_v5",
      "userNodeMin": 1,
      "userNodeMax": 2,
      "userNodeSizeComment": "2026-08-29: koreacentral 리전 vCPU 쿼터 소진(0 남음)으로 설계값(D4s_v5 x2, 8vCPU)에서 임시 축소(D2s_v5 x1, 2vCPU)",
      "zones": [
        1,
        2,
        3
      ],
      "networkPlugin": "azure",
      "networkPluginMode": "overlay"
    },
    "data": {
      "postgres": {
        "name": "psql-myapp-prd",
        "tier": "GeneralPurpose",
        "sku": "Standard_D2ds_v4",
        "storageGb": 128,
        "version": "16",
        "haMode": "ZoneRedundant",
        "backupRetentionDays": 14,
        "adminUser": "pgadminuser",
        "adminPasswordEnvVar": "PRD_DB_ADMIN_PASSWORD",
        "database": "appdb"
      },
      "redis": {
        "name": "redis-myapp-prd",
        "sku": "Standard",
        "vmSize": "c1"
      },
      "storage": {
        "namePrefix": "stmyappprd",
        "sku": "Standard_ZRS"
      },
      "keyvault": {
        "namePrefix": "kv-myapp-prd"
      }
    },
    "observability": {
      "logAnalytics": "law-myapp-prd",
      "appInsights": "ai-myapp-prd",
      "enableManagedPrometheus": true,
      "enableContainerInsights": true
    }
  },
  "skipPaasData": true,
  "skipPaasDataComment": "myapp(better-sqlite3, GitHub/Notion API만 사용)은 PostgreSQL·Redis·Storage를 실제로 쓰지 않는다. 2026-08-29 최종검토에서 확인, 사용자 승인 하에 미생성으로 전환.",
  "argocd": {
    "namespace": "argocd",
    "appName": "myapp-prd",
    "project": "myapp",
    "repoUrl": "https://github.com/kyum22n/advanced-cloud-developer.git",
    "targetRevision": "master",
    "path": "배포/prd/config/k8s/overlays/prd",
    "syncPolicy": "manual",
    "syncPolicyComment": "운영은 자동 동기화 대신 '사람 승인 후 수동 Sync' 를 기본으로 한다"
  },
  "identity": {
    "description": "Managed Identity / Workload Identity 기반 자격 증명 설계 — 비밀을 '잘 보관'하기 전에 '만들지 않는다'",
    "userAssignedName": "id-myapp-prd",
    "federatedCredentialName": "fc-myapp",
    "audience": "api://AzureADTokenExchange",
    "passwordless": {
      "acr": true,
      "acrHow": "AKS kubelet 관리 ID 에 AcrPull — imagePullSecret 을 만들지 않는다",
      "keyVault": true,
      "keyVaultHow": "워크로드 ID + CSI — 파드가 토큰으로 시크릿을 읽는다",
      "storage": false,
      "storageHow": "myapp 미사용 — skipPaasData=true 로 생성 자체를 생략",
      "postgres": false,
      "postgresHow": "myapp 미사용(SQLite) — skipPaasData=true 로 생성 자체를 생략. Entra 권한 제약과 무관하게 애초에 불필요.",
      "redis": false,
      "redisHow": "myapp 미사용 — skipPaasData=true 로 생성 자체를 생략"
    },
    "postgresPasswordAuth": "Enabled",
    "postgresPasswordAuthComment": "실습 호환을 위해 암호 인증을 함께 유지한다. 운영 목표 상태는 'Disabled' — 전환은 앱이 토큰 인증으로 바뀐 뒤에 수행한다.",
    "roleAssignments": [
      {
        "role": "Key Vault Secrets User",
        "scopeKind": "keyvault",
        "why": "시크릿 '읽기'만 필요 — 쓰기 권한을 주지 않는다"
      },
      {
        "role": "Storage Blob Data Contributor",
        "scopeKind": "storage",
        "why": "첨부·리포트 업로드/다운로드"
      },
      {
        "role": "AcrPull",
        "scopeKind": "acr",
        "why": "이미지 pull 전용 — push 권한은 CI 에만"
      }
    ],
    "forbidden": [
      "구독 범위 소유자/기여자 역할 부여",
      "서비스 주체 클라이언트 시크릿 생성·보관",
      "액세스 키·연결 문자열을 앱 설정이나 Git 에 기록"
    ]
  },
  "app": {
    "name": "myapp",
    "namespace": "myapp-prd",
    "image": "myapp",
    "replicas": 3,
    "containerPort": 8080,
    "serviceAccount": "myapp-sa",
    "workloadIdentityName": "id-myapp-prd"
  },
  "test": {
    "baseUrl": "http://20.249.70.50",
    "allowWrite": false,
    "allowWriteComment": "운영 스모크는 읽기 전용이 원칙 — 쓰기 검증은 stg 에서 끝낸다"
  }
}
