{
  "environment": "dev",
  "description": "로컬 k3d(Docker Desktop) 개발 환경 — 빠른 반복이 목적, 데이터는 언제든 버릴 수 있다",
  "cluster": {
    "name": "myapp-dev",
    "agents": 1,
    "hostPort": 8080,
    "nodePort": 30080,
    "k3sImage": "rancher/k3s:v1.30.2-k3s1"
  },
  "app": {
    "name": "myapp",
    "namespace": "myapp-dev",
    "image": "myapp",
    "tag": "dev",
    "replicas": 1,
    "containerPort": 8080
  },
  "db": {
    "mode": "embedded-sqlite",
    "comment": "myapp은 better-sqlite3(파일 기반)를 사용해 별도 DB 서버가 필요 없다. postgres.yaml은 다른 3차시 앱과의 구조 비교용으로만 보존.",
    "secretEnvVars": ["GITHUB_TOKEN", "NOTION_TOKEN", "NOTION_PARENT_PAGE_ID"]
  },
  "test": {
    "baseUrl": "http://localhost:8080",
    "allowWrite": true
  }
}
