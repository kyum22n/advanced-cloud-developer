{
  "environment": "dev",
  "description": "로컬 k3d(Docker Desktop) 개발 환경 — 빠른 반복이 목적, 데이터는 언제든 버릴 수 있다",
  "cluster": {
    "name": "myapp-dev",
    "agents": 1,
    "hostPort": 8080,
    "nodePort": 30080,
    "k3sImage": "rancher/k3s:v1.30.2-k3s1"
  },
  "app": {
    "name": "myapp",
    "namespace": "myapp-dev",
    "image": "myapp",
    "tag": "dev",
    "replicas": 1,
    "containerPort": 8080
  },
  "db": {
    "mode": "in-cluster",
    "image": "postgres:16-alpine",
    "name": "appdb",
    "user": "appuser",
    "passwordEnvVar": "DEV_DB_PASSWORD",
    "passwordDefault": "devlocal-change-me",
    "port": 5432
  },
  "test": {
    "baseUrl": "http://localhost:8080",
    "allowWrite": true
  }
}
