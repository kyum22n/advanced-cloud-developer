{
  "environment": "stg",
  "description": "Azure AKS + Argo CD GitOps 검증 환경 — 배포 방식 자체(선언·자동 동기화)를 검증한다",
  "azure": {
    "subscriptionHint": "az account show 로 확인 후 az account set 으로 지정",
    "resourceGroup": "rg-myapp-stg",
    "location": "koreacentral",
    "acrName": "acrmyappstg",
    "aks": {
      "name": "aks-myapp-stg",
      "nodeCount": 2,
      "nodeSize": "Standard_D2s_v5",
      "kubernetesVersion": "",
      "networkPlugin": "azure",
      "networkPluginMode": "overlay",
      "enableWorkloadIdentity": true,
      "enableOidcIssuer": true,
      "tier": "free"
    }
  },
  "argocd": {
    "namespace": "argocd",
    "chartVersion": "",
    "appName": "myapp-stg",
    "project": "myapp",
    "repoUrl": "https://github.com/kyum22n/advanced-cloud-developer.git",
    "targetRevision": "master",
    "path": "배포/stg/config/k8s/overlays/stg",
    "syncPolicy": "automated",
    "localPortForward": 8090
  },
  "app": {
    "name": "myapp",
    "namespace": "myapp-stg",
    "image": "myapp",
    "replicas": 2,
    "containerPort": 8080
  },
  "db": {
    "mode": "in-cluster",
    "comment": "stg 는 배포 방식 검증이 목적이므로 DB는 컨테이너로 둔다. PaaS DB 검증은 prd 에서 수행.",
    "name": "appdb",
    "user": "appuser",
    "passwordEnvVar": "STG_DB_PASSWORD"
  },
  "test": {
    "baseUrl": "http://20.249.47.142",
    "baseUrlComment": "40_deploy.ps1 실행 후 Ingress/LoadBalancer IP 로 자동 채워집니다",
    "allowWrite": true
  }
}
