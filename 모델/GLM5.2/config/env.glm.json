{
  "$comment": "인프라 설정. 배포/prd/config/env.prd.json 과 같은 방식으로 값을 한곳에 모은다.",
  "environment": "glm-prd",
  "azure": {
    "resourceGroup": "rg-glm-prd",
    "location": "koreacentral",
    "reuseAksFrom": {
      "$comment": "앱 클러스터를 재사용한다(ADR-G-01). 별도 클러스터를 쓰려면 여기를 비우고 20_config 가 만들게 한다.",
      "resourceGroup": "rg-myapp-prd",
      "aksName": "aks-myapp-prd"
    },
    "acrName": "<전역 고유 ACR 이름으로 교체>",
    "storage": {
      "namePrefix": "stglmweights",
      "container": "models",
      "sku": "Standard_LRS",
      "accessTier": "Hot",
      "allowSharedKeyAccess": false
    },
    "keyVault": { "namePrefix": "kv-glm-prd" },
    "gpu": {
      "$comment": "GPU 1장당 단가로 비교해 고른다(03 §4-1). sizing.py 결과에 맞춰 조정.",
      "nodePoolName": "gpu",
      "sku": "Standard_NC24ads_A100_v4",
      "gpusPerNode": 1,
      "perPod": 1,
      "minCount": 0,
      "maxCount": 4,
      "priority": "Spot",
      "evictionPolicy": "Delete",
      "spotMaxPrice": -1,
      "taint": "sku=gpu:NoSchedule",
      "label": "workload=llm",
      "osDiskType": "Ephemeral"
    },
    "onDemandStandby": {
      "$comment": "Spot 회수 대비 예비 노드. 대화형 서비스라면 1 이상을 권장한다(03 §6).",
      "enabled": false,
      "nodePoolName": "gpu-od",
      "minCount": 1,
      "maxCount": 2
    },
    "tags": { "workload": "llm", "model": "glm5.2", "env": "prd" }
  },
  "identity": {
    "userAssignedName": "id-glm-prd",
    "federatedCredentialName": "fc-glm",
    "audience": "api://AzureADTokenExchange",
    "roleAssignments": [
      { "role": "Storage Blob Data Reader", "scopeKind": "storage", "why": "가중치는 '읽기'만 필요하다 — 쓰기 권한은 주지 않는다" },
      { "role": "Key Vault Secrets User",   "scopeKind": "keyvault", "why": "API 키·HF 토큰 읽기" },
      { "role": "AcrPull",                  "scopeKind": "acr",      "why": "이미지 pull 전용" }
    ],
    "forbidden": [
      "저장소 계정 키·연결 문자열 사용",
      "구독 범위 역할 부여",
      "서비스 주체 클라이언트 시크릿 생성"
    ]
  },
  "k8s": {
    "namespace": "glm-serving",
    "serviceAccount": "glm-sa",
    "appName": "glm",
    "servicePort": 8000,
    "allowedClientNamespaces": ["myapp-prd"],
    "replicas": 1,
    "startupProbeFailureThreshold": 60,
    "startupProbePeriodSeconds": 10
  },
  "test": {
    "baseUrl": "",
    "baseUrlComment": "40_deploy 이후 포트포워딩 주소 또는 클러스터 내부 주소",
    "concurrency": [1, 4, 10, 20],
    "warmupRequests": 3
  }
}
